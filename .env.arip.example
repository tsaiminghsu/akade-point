# ARIP Backend Environment Variables
# Copy to .env.arip and fill in values

ARIP_PORT=3001
NODE_ENV=development

# PostgreSQL (matches docker-compose.arip.yml defaults)
DATABASE_URL=postgresql://arip:arip@localhost:5432/arip

# Redis
REDIS_URL=redis://localhost:6379

# MQTT (Mosquitto)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=arip-backend-bridge

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=arip_minio
MINIO_SECRET_KEY=arip_minio_secret
MINIO_USE_SSL=false
MINIO_BUCKET=arip

# Node-RED Workflow Provider
NODE_RED_BASE_URL=http://localhost:1880
NODE_RED_API_KEY=

# Next.js will read these (add to .env.local too)
# NEXT_PUBLIC_ARIP_API_URL=http://localhost:3001/api/v1
# NEXT_PUBLIC_ARIP_WS_URL=ws://localhost:3001
