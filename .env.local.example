# NextAuth
NEXTAUTH_URL=https://your-domain.amplifyapp.com
NEXTAUTH_SECRET=your-secret-here

# LINE OAuth (from LINE Developer Console)
LINE_CLIENT_ID=your-line-channel-id
LINE_CLIENT_SECRET=your-line-channel-secret

# AWS
AWS_REGION=ap-northeast-1
# On Amplify, credentials come from IAM role — no keys needed
# For local dev, use AWS CLI profile or:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Ship Tracker: optional Python YOLO backend for the optical detection tab
# NEXT_PUBLIC_SHIP_TRACKER_BACKEND_URL=http://localhost:8000

# Ship Tracker: optional live AIS feed. Without it the radar runs on its
# built-in Kaohsiung simulation. Free key from https://aisstream.io
# AISSTREAM_API_KEY=your-aisstream-key
