# NextAuth
NEXTAUTH_URL=https://your-domain.amplifyapp.com
NEXTAUTH_SECRET=your-secret-here

# LINE OAuth (from LINE Developer Console)
LINE_CLIENT_ID=your-line-channel-id
LINE_CLIENT_SECRET=your-line-channel-secret

# AWS
AWS_REGION=ap-northeast-1
# On Amplify, credentials come from IAM role — no keys needed
# For local dev, use AWS CLI profile or:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Local DynamoDB (set by `npm run dynamodb:local`; leave unset in production)
# DYNAMODB_LOCAL_ENDPOINT=http://localhost:8500

# Claw machine config notices: ring a machine's ESP32 over MQTT when its
# config is saved, so it pulls at once instead of at its next 30 s poll.
#   iot  = AWS IoT Core via IOT_DATA_ENDPOINT (role needs iot:Publish on topic/claw/*)
#   mqtt = any broker at CLAW_MQTT_URL (`npm run mqtt:dev` starts one locally)
#   unset = off; boards just poll
# CLAW_CONFIG_NOTIFY=mqtt
# CLAW_MQTT_URL=mqtt://localhost:1883
# iot mode (shared with vehicles): aws iot describe-endpoint --endpoint-type iot:Data-ATS
# IOT_DATA_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.ap-northeast-1.amazonaws.com
# What boards on the LAN should connect to (localhost is the ESP32 itself):
# CLAW_MQTT_DEVICE_URL=mqtt://192.168.1.20:1883

# Vehicles: how commands reach the companion.
#   local (default) = the companion collects them from its 1 Hz telemetry response
#   iot             = also publish to AWS IoT Core (IOT_DATA_ENDPOINT; role needs iot:Publish on topic/vehicles/*)
# VEHICLE_TRANSPORT=local
