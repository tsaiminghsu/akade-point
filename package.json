{
  "name": "akade-point",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n NEXT,SHIP,DDB -c blue,cyan,magenta \"next dev\" \"npm run ship-tracker\" \"npm run dynamodb:local\"",
    "dev:next": "next dev",
    "ship-tracker": "cd backend && uvicorn backend:app --host 0.0.0.0 --port 8000",
    "dynamodb:local": "node scripts/start-dynamodb-local.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1073.0",
    "@aws-sdk/lib-dynamodb": "^3.1073.0",
    "@dimforge/rapier3d-compat": "^0.19.2",
    "@next-auth/dynamodb-adapter": "^3.0.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@pixi/filter-bloom": "^5.1.1",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/rapier": "^2.2.0",
    "@types/three": "^0.184.1",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.26.0",
    "next": "14.2.35",
    "next-auth": "^4.24.14",
    "pixi.js": "^7.4.3",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.80.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^10.0.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
